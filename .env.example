CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
IG_USER_ID=your_instagram_business_account_id
IG_ACCESS_TOKEN=your_long_lived_access_token
IG_GRAPH_API_VERSION=v25.0

# Telegram bot created with @BotFather.
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=your_bot_token
# Comma-separated numeric IDs. Send /start to the bot to see your ID.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Instagram DM intake webhook. Use a long random verify token and your Meta
# app's App Secret. Sender IDs are discovered after they DM the account.
META_WEBHOOK_VERIFY_TOKEN=choose_a_long_random_verify_token
META_APP_SECRET=your_meta_app_secret
IG_DM_ALLOWED_SENDER_IDS=123456789012345

# Password protection for the remotely hosted web interface.
REELPOSTER_WEB_USERNAME=reelposter
REELPOSTER_WEB_PASSWORD=choose_a_long_random_password

# Calendar times entered in Telegram use this IANA timezone.
APP_TIMEZONE=Asia/Kolkata

# Optional persistent data location. Render sets this to its mounted disk.
REELPOSTER_DATA_DIR=

# Optional: path to a Netscape-format cookies.txt file for a supported source.
# Avoid cookies from your main Instagram account on a hosted/datacenter server;
# that can trigger repeated security verification.
YTDLP_COOKIES_FILE=

# Optional: full path to ffmpeg.exe. Usually unnecessary because the Python
# dependencies include a bundled FFmpeg binary.
FFMPEG_BINARY=

# Optional local server settings.
PORT=5000
FLASK_DEBUG=false
